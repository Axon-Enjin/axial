# =============================================================================
# Axial Web — environment variables
# Copy to web/.env.local for local dev. For Vercel: see docs/vercel-deployment.md
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REQUIRED ON VERCEL (demo will not work without these)
# -----------------------------------------------------------------------------

# Supabase project: ifzyntqwymmgimnxtguz
# Dashboard → Project Settings → API
SUPABASE_URL=https://ifzyntqwymmgimnxtguz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase vars (browser + middleware auth)
# NEXT_PUBLIC_ prefix is required — these are safe to expose (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://ifzyntqwymmgimnxtguz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # Dashboard → Project Settings → API → anon/public key

# Base URL for OAuth redirects, invite links, and funder portal share URLs
# LOCAL:  http://localhost:3000  (npm run dev)
# PROD:   your Cloud Run URL     (GitHub Actions / GCP deploy)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stellar Mainnet signing — from your machine after deploy:
#   cd soroban && ./scripts/write-web-env.sh  (or copy from deployments/mainnet.json)
# Never commit these; Cloud Run / GitHub Secrets → Sensitive
MAINNET_STELLAR_FUNDER_SECRET=
MAINNET_STELLAR_MSME_SECRET=
MAINNET_STELLAR_ISSUER_SECRET=

# -----------------------------------------------------------------------------
# 2. RECOMMENDED ON VERCEL / CLOUD RUN (public chain IDs — overrides bundled mainnet.json)
# Copy from soroban/deployments/mainnet.json after deploy
# -----------------------------------------------------------------------------

MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
MAINNET_STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

MAINNET_AXIAL_SWAP_CONTRACT_ID=
MAINNET_RECEIVABLE_TOKEN_CONTRACT_ID=
MAINNET_PAYROLL_SPLIT_CONTRACT_ID=
MAINNET_SETTLEMENT_CONTRACT_ID=
MAINNET_SOROBAN_USDC_TOKEN_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# Track A contractor USDC pay — Testnet only (never Mainnet until dry-run + counsel).
# TESTNET_CONTRACTOR_PAYROLL_CONTRACT_ID=
# TESTNET_SOROBAN_USDC_TOKEN_ID=
# TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

MAINNET_STELLAR_ISSUER_PUBLIC=
MAINNET_STELLAR_FUNDER_PUBLIC=
MAINNET_STELLAR_MSME_PUBLIC=

# Legacy unprefixed vars (deprecated — use MAINNET_* above). Kept for local dev sandboxes only.
# SOROBAN_RPC_URL=
# STELLAR_NETWORK_PASSPHRASE=
# AXIAL_SWAP_CONTRACT_ID=
# RECEIVABLE_TOKEN_CONTRACT_ID=
# PAYROLL_SPLIT_CONTRACT_ID=
# SOROBAN_USDC_TOKEN_ID=
# SETTLEMENT_CONTRACT_ID=
# STELLAR_ISSUER_PUBLIC=
# STELLAR_FUNDER_PUBLIC=
# STELLAR_MSME_PUBLIC=
# STELLAR_FUNDER_SECRET=
# STELLAR_MSME_SECRET=
# STELLAR_ISSUER_SECRET=

# -----------------------------------------------------------------------------
# 3. OPTIONAL — BIR EIS mock oracle & demo metadata
# -----------------------------------------------------------------------------

# Secures the /api/eis/worker and /api/eis/horizon-poll cron endpoints.
# Vercel automatically sets CRON_SECRET for the cron runtime.
# For manual calls: Authorization: Bearer {value}
CRON_SECRET=

EIS_JWS_MOCK_SECRET=axial-hackathon-eis-mock-key
AXIAL_ORG_ID=demo-org
# KYB: mock (auto-verify) | manual (admin review) | vendor (future)
AXIAL_KYB_MODE=mock

# -----------------------------------------------------------------------------
# 6. BIR EIS LIVE (production — requires Permit to Transmit)
# Default is mock mode. Set BIR_EIS_LIVE=true + the fields below to go live.
# See docs/clr-axial.md for the PTT certification path.
# -----------------------------------------------------------------------------
# BIR_EIS_LIVE=true
# BIR_EIS_ENDPOINT=https://eis-staging.bir.gov.ph/api   # staging; change to prod URL
# BIR_EIS_API_KEY=                                       # BIR-issued key after PTT approval
# BIR_JWS_PRIVATE_KEY_B64=                               # base64(PKCS#8 PEM private key)
# BIR_JWS_KEY_ID=                                        # BIR-issued key ID (from PTT enrollment)
# Demo only: after prepare, auto-call BIR mock + memo without human Approve.
# Also enabled when AXIAL_ALLOW_SEED=true (and BIR_EIS_LIVE is not true).
# EIS_DEMO_AUTO_ACK=false

# Optional advisory LLM for POST /api/eis/[id]/explain (never auto-submits).
# See docs/rfc-axial-eis-explain.md
# EIS_EXPLAIN_LLM=true
# EIS_EXPLAIN_LLM_URL=https://api.openai.com/v1/chat/completions
# EIS_EXPLAIN_LLM_API_KEY=
# EIS_EXPLAIN_LLM_MODEL=gpt-4o-mini

AXIAL_SELLER_TIN=123-456-789-00000
AXIAL_SELLER_NAME=Axial Demo MSME Inc.
AXIAL_SELLER_ADDRESS=Makati City, Metro Manila, PH
AXIAL_BUYER_TIN=987-654-321-00000
AXIAL_BUYER_NAME=Acme Logistics Corp
AXIAL_BUYER_ADDRESS=BGC, Taguig City, Metro Manila, PH

# -----------------------------------------------------------------------------
# 4. OCR ON VERCEL (image PNG/JPEG — off by default when VERCEL=1)
# Tesseract needs Pro + 60s functions; use parse-sample or PDF on Hobby
# -----------------------------------------------------------------------------
# AXIAL_OCR_ENABLED=true

# -----------------------------------------------------------------------------
# 5. DEMO / PREVIEW ONLY — do not enable on a public production URL
# Allows POST /api/invoices/seed and auto-seed on empty book — enable for local dev only
AXIAL_ALLOW_SEED=true

# Read-only funder portal magic link (?token=...) for external LPs
# Generate: soroban/scripts/ensure-funder-portal-token.ps1
# Upload to GCP: soroban/scripts/upload-gcp-cloudrun-env.ps1
# AXIAL_FUNDER_PORTAL_TOKEN=

# Telegram MSME ops bot (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=

# Server-side anon key fallback (used by middleware when NEXT_PUBLIC_ is not set)
# Normally use NEXT_PUBLIC_SUPABASE_ANON_KEY above for the browser client.
# SUPABASE_ANON_KEY=

# Alternate memo signer (defaults to STELLAR_ISSUER_SECRET)
# STELLAR_ORACLE_SECRET=
