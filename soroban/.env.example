# Copy to soroban/.env (gitignored). Each developer uses their OWN Stellar identity.
# Generate: stellar keys generate yourname-axial --network testnet
# Fund:     stellar keys fund yourname-axial --network testnet

# Identity name in ~/.config/stellar/identity/ (NOT the secret key)
STELLAR_SOURCE=yourname-axial

# testnet | mainnet
STELLAR_NETWORK=testnet

# Filled after deploy — copy from deployments/testnet.json or paste here
RECEIVABLE_TOKEN_CONTRACT_ID=
AXIAL_SWAP_CONTRACT_ID=
PAYROLL_SPLIT_CONTRACT_ID=

# Circle USDC on Stellar Mainnet (settlement reference — docs/Axial.md)
USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
